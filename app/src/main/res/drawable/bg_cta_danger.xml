<?xml version="1.0" encoding="utf-8"?>
<!--
    Опасное действие (стоп/отмена): капсула с градиентом #FF7A7A → #C0392B.
    Радиус капсулы 30 dp, как у основного CTA.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#C0392B"
        android:startColor="#FF7A7A"
        android:type="linear" />
    <corners android:radius="30dp" />
</shape>
