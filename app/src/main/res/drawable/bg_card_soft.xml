<?xml version="1.0" encoding="utf-8"?>
<!--
    Мягкая карточка: surface + обводка stroke 1 dp.
    Токены: docs/design-tokens.md (surface #111A1E, stroke #1B262B), радиус 20 dp.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#111A1E" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#1B262B" />
</shape>
