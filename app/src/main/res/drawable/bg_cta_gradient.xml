<?xml version="1.0" encoding="utf-8"?>
<!--
    Главное действие: капсула с градиентом accent_from → accent_to.
    Токены: docs/design-tokens.md (accent_from #22E0B4, accent_to #00A9C0), радиус капсулы 30 dp.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#00A9C0"
        android:startColor="#22E0B4"
        android:type="linear" />
    <corners android:radius="30dp" />
</shape>
